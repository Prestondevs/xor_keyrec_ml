    "### xor functions\n",
    "Not sure if these will be useful or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4bfead22",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def xor(word: str, key: int):\n",
    "    chars = []\n",
    "    for i in word:\n",
    "        chars.append(chr(ord(i)^key))\n",
    "    return(\"\".join(chars))\n",
    "\n",
    "def rotating_xor(word: str, key: int):\n",
    "    chars = []\n",
    "    for i in word:\n",
    "        key+=1\n",
    "        chars.append(chr(ord(i)^key))\n",
    "    return(\"\".join(chars))\n",
    "\n",
    "\n",
    "print(xor(\"m`iij\", 5))\n",
    "print(rotating_xor(\"nbdee\", 5))\n"
   ]
  },
