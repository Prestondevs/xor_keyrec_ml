   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "def frequency_counter(text: str)->dict:\n",
    "    frequency = {}\n",
    "    for char in text:\n",
    "        if char in frequency:\n",
    "            frequency[char] += 1\n",
    "        else:\n",
    "            frequency[char] = 1\n",
    "    return frequency\n",
    "\n",
    "df = pd.read_csv(\"data.csv\")\n",
    "ciphertext_hex = df.at[1, \"ciphertext_hex\"]\n",
    "\n",
    "char_counts = frequency_counter(ciphertext_hex)\n",
    "characters = list(char_counts.keys())\n",
    "frequencies = list(char_counts.values())\n",
    "\n",
    "plt.bar(characters, frequencies)\n",
    "plt.xlabel(\"Characters\")\n",
    "plt.ylabel(\"Frequencies\")\n",
    "plt.title(\"Character Frequency Graph\")\n",
    "plt.show()"
   ]
  },
  {
